# ==========================================
# CitriScan — .gitignore
# ==========================================

# ---- SECRETS & CREDENTIALS (CRITICAL) ----
.env
.env.local
.env.*.local
*.local
serviceAccountKey.json
firebase-admin-key.json
firebase-*.json
kaggle.json
*.pem
*.key

# ---- Python ----
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
*.so
.pytest_cache/

# ---- Node.js ----
node_modules/
dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- Deep Learning Models (too large for GitHub) ----
*.h5
*.hdf5
*.pb
*.tflite
models/*.h5

# ---- Datasets (users download via download_data.py) ----
Citrus_Leaves_Raw/
Citrus_Leaves_Split/

# ---- User Uploads (from Flask app testing) ----
uploads/

# ---- OS Generated ----
.DS_Store
Thumbs.db

# ---- IDE / Editor ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Local databases & logs ----
*.sqlite3
*.db